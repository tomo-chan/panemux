#!/bin/sh
# Stands in for lsof in the task-dashboard e2e fixture (review on #430). It
# runs the real lsof, E2E_REAL_LSOF, only for the argument shapes panemux
# passes:
#
#   -a -p <pid> -d cwd -Fn
#   -a -p <pid> -Fn
#   -p <pid> -Fn
#   -n -P -a -p <pids> -d cwd -Fpn
#   -n -P -p <pids> -Fpn
#
# and only when every named process is answered for by the ps beside it — one
# that descends from the fixture. Any non-descendant process answers nothing,
# as one that does not exist; any other shape is refused, with an error and no
# output.
set -u

refuse() {
	echo "lsof stand-in: refused: lsof $*" >&2
	exit 2
}

mode=single
case "$#:${1-}:${2-}:${3-}:${4-}:${5-}:${6-}:${7-}:${8-}" in
6:-a:-p:*:-d:cwd:-Fn:: | 4:-a:-p:*:-Fn:::: ) pids=$3 ;;
3:-p:*:-Fn::::: ) pids=$2 ;;
8:-n:-P:-a:-p:*:-d:cwd:-Fpn ) mode=batch; pids=$5 ;;
5:-n:-P:-p:*:-Fpn::: ) mode=batch; pids=$4 ;;
*) refuse "$@" ;;
esac

case "$mode:$pids" in
single:'' | single:*[!0-9]*) refuse "$@" ;;
batch:'' | batch:,* | batch:*, | batch:*,,* | batch:*[!0-9,]*) refuse "$@" ;;
esac

[ -n "${E2E_REAL_LSOF:-}" ] || exit 1
ps_bin="$(dirname "$0")/ps"
old_ifs=$IFS
IFS=,
set -f
for pid in $pids; do
	IFS=$old_ifs
	"$ps_bin" -p "$pid" -o pid= >/dev/null 2>&1 || exit 1
	IFS=,
done
IFS=$old_ifs
set +f
exec "$E2E_REAL_LSOF" "$@"

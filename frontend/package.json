{
  "name": "panemux-frontend",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "scripts": {
    "dev": "../scripts/runtime-shell.sh --run vite",
    "build": "../scripts/runtime-shell.sh -c 'tsc && vite build \"$@\"' --",
    "preview": "../scripts/runtime-shell.sh --run vite preview",
    "test": "../scripts/runtime-shell.sh --run vitest run",
    "test:watch": "../scripts/runtime-shell.sh --run vitest",
    "test:ci": "../scripts/runtime-shell.sh --run vitest run --reporter=default --reporter=junit --outputFile=../test-results/vitest.xml",
    "coverage": "../scripts/runtime-shell.sh --run vitest run --coverage",
    "test:e2e": "../scripts/runtime-shell.sh --run playwright test",
    "screenshots": "../scripts/runtime-shell.sh --run playwright test -c screenshots/playwright.config.ts",
    "preinstall": "sh ../scripts/check-node.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
